# ==============================================================================
# AI Interview Coach — Environment Variable Blueprint
# ==============================================================================
# Duplicate this file as appropriate:
# - backend/.env
# - frontend/.env.local
#
# NEVER commit raw keys, credentials, or actual secrets to version control.
# ==============================================================================

# --- Backend Configuration (backend/.env) ---
# Required: Groq Cloud API Key (obtain from https://console.groq.com)
GROQ_API_KEY=

# Optional: Groq LLM model identifier (defaults to openai/gpt-oss-120b)
GROQ_MODEL=

# Optional: Allowed CORS origins (comma-separated, e.g. http://localhost:3000,https://your-domain.com)
ALLOWED_ORIGINS=

# --- Frontend Configuration (frontend/.env.local) ---
# Base URL pointing to the FastAPI backend service (e.g. http://localhost:8000)
NEXT_PUBLIC_API_URL=
